fn fib($n : i32) -> i32
    $a : i32 = 0
    $b : i32 = 1
    $i : i32 = 0
    
    loop:
    $done : i32 = sub $i, $n
    jz $done, exit
    $tmp : i32 = add $a, $b
    $a : i32 = $b
    $b : i32 = $tmp
    $i : i32 = add $i, 1
    jmp loop
    
    exit:
    ret $a

fn main()
    $n : i32 = 10
    $res : i32 = call fib, $n
    ret
